        {
          "name": "1-1. [201] POST 여러 개 생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"상태 코드 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"success = true\", () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bulk"
              ]
            },
            "description": "keyboard, mouse, cable 3개 생성 → id 1, 2, 3",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\"name\": \"keyboard\", \"price\": 50000},\n  {\"name\": \"mouse\", \"price\": 20000},\n  {\"name\": \"cable\", \"price\": 3000}\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
